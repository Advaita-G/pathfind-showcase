{
  "name": "pathfind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "eval:assistant:offline": "node evals/assistant/run.mjs --offline",
    "eval:assistant:check": "node --test evals/assistant/selfcheck.mjs",
    "dev": "vite",
    "build": "tsc && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:seo": "npm run build && playwright test --config=playwright.seo.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@theatre/core": "^0.7.2",
    "@theatre/studio": "^0.7.2",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
