{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/research", "destination": "/research-programs", "permanent": true },
    { "source": "/computer-science", "destination": "/interests/computer-science", "permanent": true },
    { "source": "/artificial-intelligence", "destination": "/interests/data-science-ai", "permanent": true },
    { "source": "/ai", "destination": "/interests/data-science-ai", "permanent": true },
    { "source": "/math", "destination": "/interests/math", "permanent": true },
    { "source": "/engineering", "destination": "/interests/engineering-robotics", "permanent": true },
    { "source": "/9th-grade", "destination": "/grades/9", "permanent": true },
    { "source": "/10th-grade", "destination": "/grades/10", "permanent": true },
    { "source": "/11th-grade", "destination": "/grades/11", "permanent": true },
    { "source": "/12th-grade", "destination": "/grades/12", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
